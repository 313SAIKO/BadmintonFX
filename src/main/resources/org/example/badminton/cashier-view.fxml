<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.badminton.CashierController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header">
            <Label styleClass="header-title" text="ระบบจองสนามแบดมินตัน" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblUser" />
            <Button onAction="#onLogoutButtonClick" text="ออกจากระบบ" />
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">

            <!-- ==================== จองสนาม ==================== -->
            <Tab fx:id="tabBooking" text="จองสนาม">
                <HBox spacing="16.0">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                    </padding>

                    <ScrollPane fitToWidth="true" minWidth="400.0" prefWidth="400.0" styleClass="plain-scroll">
                        <VBox spacing="10.0" styleClass="card">
                            <Label styleClass="section-title" text="1. เลือกสมาชิก" />
                            <TextField fx:id="txtMemberSearch" onAction="#onMemberSearchEnter"
                                       promptText="พิมพ์รหัส ชื่อ หรือเบอร์โทร เพื่อค้นหา" />
                            <ListView fx:id="lstMembers" prefHeight="88.0" />
                            <Label fx:id="lblMemberInfo" maxWidth="Infinity" styleClass="hint" wrapText="true" />

                            <Label styleClass="section-title" text="2. เลือกสนามและเวลา (จากตารางด้านขวา)" />
                            <GridPane hgap="8.0" vgap="8.0">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="20.0" />
                                    <ColumnConstraints percentWidth="30.0" />
                                    <ColumnConstraints percentWidth="20.0" />
                                    <ColumnConstraints percentWidth="30.0" />
                                </columnConstraints>
                                <Label text="สนาม:" GridPane.rowIndex="0" />
                                <ComboBox fx:id="cboCourt" maxWidth="Infinity" promptText="-"
                                          GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <Label text="เวลาเริ่ม:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                <ComboBox fx:id="cboStartHour" maxWidth="Infinity"
                                          GridPane.columnIndex="3" GridPane.rowIndex="0" />
                                <Label text="ชั่วโมง:" GridPane.rowIndex="1" />
                                <Spinner fx:id="spnHours" initialValue="1" max="11" min="1" maxWidth="Infinity"
                                         GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </GridPane>

                            <Label fx:id="lblPrice" maxWidth="Infinity" styleClass="price-box" wrapText="true" />

                            <VBox fx:id="boxSlip" spacing="8.0">
                                <Label styleClass="section-title" text="3. แนบสลิปการชำระเงิน" />
                                <HBox spacing="6.0">
                                    <TextField fx:id="txtSlipNo" prefWidth="110.0" promptText="เลขที่สลิป" />
                                    <TextField fx:id="txtSlipFile" editable="false" promptText="ยังไม่ได้แนบไฟล์"
                                               HBox.hgrow="ALWAYS" />
                                    <Button minWidth="-Infinity" onAction="#onChooseSlipButtonClick" text="แนบไฟล์..." />
                                </HBox>
                            </VBox>

                            <Button fx:id="btnBook" maxWidth="Infinity" onAction="#onBookButtonClick"
                                    styleClass="primary-button" text="ยืนยันการจอง" />
                            <Label fx:id="lblBookResult" wrapText="true" />
                            <Button fx:id="btnRentForMember" managed="false" maxWidth="Infinity"
                                    onAction="#onRentForMemberButtonClick" visible="false" />
                        </VBox>
                    </ScrollPane>

                    <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Label styleClass="section-title" text="ตารางสนาม" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#onPrevDayButtonClick" text="« วันก่อน" />
                            <DatePicker fx:id="dpDate" prefWidth="140.0" />
                            <Button onAction="#onNextDayButtonClick" text="วันถัดไป »" />
                            <Button onAction="#onTodayButtonClick" text="วันนี้" />
                        </HBox>
                        <Label fx:id="lblScheduleTitle" styleClass="hint" wrapText="true" />
                        <Label styleClass="schedule-help" maxWidth="Infinity" wrapText="true"
                               text="วิธีเลือก: คลิกช่องสีเขียวช่องแรก แล้วคลิกช่องสุดท้ายในสนามเดียวกัน (หรือกดค้างแล้วลากลง) เพื่อจองหลายชั่วโมง  •  คลิกช่องที่เลือกไว้ซ้ำเพื่อยกเลิก" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="legend-free" text="ว่าง (คลิกเพื่อเลือก)" />
                            <Label styleClass="legend-selected" text="ช่วงที่เลือก" />
                            <Label styleClass="legend-booked" text="จองแล้ว (ชี้เพื่อดูรายละเอียด)" />
                            <Label styleClass="legend-conflict" text="ทับกับการจองอื่น" />
                        </HBox>
                        <ScrollPane fitToWidth="true" styleClass="plain-scroll" VBox.vgrow="ALWAYS">
                            <GridPane fx:id="gridSchedule" hgap="4.0" vgap="4.0" />
                        </ScrollPane>
                    </VBox>
                </HBox>
            </Tab>

            <!-- ==================== สมาชิก ==================== -->
            <Tab text="สมาชิก">
                <VBox spacing="12.0">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card">
                        <Label styleClass="section-title" text="สมัครสมาชิกใหม่" />
                        <TextField fx:id="txtNewName" prefWidth="230.0" promptText="ชื่อ-นามสกุล" />
                        <TextField fx:id="txtNewPhone" prefWidth="160.0" promptText="เบอร์โทร" />
                        <Button onAction="#onRegisterButtonClick" styleClass="primary-button" text="สมัครสมาชิก" />
                        <Label fx:id="lblRegisterResult" wrapText="true" />
                    </HBox>
                    <Label styleClass="hint" text="ดับเบิลคลิกที่สมาชิกเพื่อไปจองสนามให้สมาชิกคนนั้น" />
                    <TableView fx:id="tblMembers" VBox.vgrow="ALWAYS" />
                </VBox>
            </Tab>

            <!-- ==================== แพ็กเกจ ==================== -->
            <Tab text="แพ็กเกจ 15 ชั่วโมง">
                <VBox spacing="12.0">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                    </padding>
                    <VBox maxWidth="560.0" spacing="10.0" styleClass="card">
                        <Label styleClass="section-title" text="ขายแพ็กเกจเหมาจ่าย 15 ชั่วโมง ราคา 2,600 บาท" />
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="105.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <Label text="สมาชิก:" GridPane.rowIndex="0" />
                            <ComboBox fx:id="cboPackageMember" maxWidth="Infinity" promptText="เลือกสมาชิก"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label text="วันที่ซื้อ:" GridPane.rowIndex="1" />
                            <DatePicker fx:id="dpPackageDate" maxWidth="Infinity"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        </GridPane>
                        <Label fx:id="lblPackageInfo" maxWidth="Infinity" styleClass="price-box" wrapText="true" />
                        <Button onAction="#onSellPackageButtonClick" styleClass="primary-button" text="ขายแพ็กเกจ" />
                        <Label fx:id="lblPackageResult" wrapText="true" />
                    </VBox>
                </VBox>
            </Tab>

            <!-- ==================== อุปกรณ์ ==================== -->
            <Tab fx:id="tabItems" text="เช่า/ซื้ออุปกรณ์">
                <HBox spacing="16.0">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                    </padding>

                    <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                        <Label styleClass="section-title" text="1. เลือกอุปกรณ์" />
                        <Label styleClass="hint" wrapText="true"
                               text="ดับเบิลคลิกที่อุปกรณ์เพื่อเพิ่มลงตะกร้า หรือเลือกแล้วกดปุ่ม &quot;เพิ่มลงตะกร้า&quot; ใส่ได้หลายรายการทั้งของเช่าและของขาย" />
                        <TableView fx:id="tblItems" VBox.vgrow="ALWAYS" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label fx:id="lblSelectedItem" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS" />
                            <Label text="จำนวน:" />
                            <Spinner fx:id="spnQuantity" initialValue="1" max="50" min="1" prefWidth="80.0" />
                            <Button onAction="#onAddToCartButtonClick" styleClass="primary-button" text="เพิ่มลงตะกร้า" />
                        </HBox>
                    </VBox>

                    <VBox minWidth="430.0" prefWidth="430.0" spacing="10.0" styleClass="card">
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="section-title" text="2. ตะกร้า" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#onClearCartButtonClick" text="ล้างตะกร้า" />
                        </HBox>
                        <TableView fx:id="tblCart" VBox.vgrow="ALWAYS" />
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="70.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <Label text="ลูกค้า:" GridPane.rowIndex="0" />
                            <ComboBox fx:id="cboCustomer" editable="true" maxWidth="Infinity"
                                      promptText="พิมพ์ชื่อ หรือเลือกจากรายชื่อสมาชิก"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label text="วันที่:" GridPane.rowIndex="1" />
                            <DatePicker fx:id="dpItemDate" maxWidth="Infinity"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        </GridPane>
                        <Label fx:id="lblCartTotal" maxWidth="Infinity" styleClass="price-box" wrapText="true" />
                        <Button fx:id="btnCheckout" maxWidth="Infinity" onAction="#onCheckoutButtonClick"
                                styleClass="primary-button" text="ยืนยันรายการ" />
                        <Label fx:id="lblItemResult" minHeight="-Infinity" wrapText="true" />
                    </VBox>
                </HBox>
            </Tab>

            <!-- ==================== ค้นหาการจอง ==================== -->
            <Tab text="ค้นหาการจอง">
                <VBox spacing="12.0">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                    </padding>
                    <fx:define>
                        <ToggleGroup fx:id="searchGroup" />
                    </fx:define>
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card">
                        <RadioButton fx:id="rdoKeyword" selected="true" text="รหัส/ชื่อ:" toggleGroup="$searchGroup" />
                        <TextField fx:id="txtKeyword" prefWidth="210.0" promptText="B0001, M001 หรือชื่อสมาชิก" />
                        <RadioButton fx:id="rdoDate" text="วันที่" toggleGroup="$searchGroup" />
                        <RadioButton fx:id="rdoCourt" text="สนาม + วันที่:" toggleGroup="$searchGroup" />
                        <ComboBox fx:id="cboSearchCourt" prefWidth="80.0" />
                        <DatePicker fx:id="dpSearchDate" prefWidth="150.0" />
                        <Button onAction="#onSearchButtonClick" styleClass="primary-button" text="ค้นหา" />
                    </HBox>
                    <Label fx:id="lblSearchResult" />
                    <TableView fx:id="tblSearch" VBox.vgrow="ALWAYS" />
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
